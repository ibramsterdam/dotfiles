#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"

case "$(uname -s)" in
  Darwin) OS=darwin; FONT_DIR="$HOME/Library/Fonts" ;;
  Linux)  OS=ubuntu; FONT_DIR="$HOME/.local/share/fonts" ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

link() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"

  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    return
  fi

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    mkdir -p "$BACKUP_DIR"
    echo "Backing up existing $dst -> $BACKUP_DIR/"
    mv "$dst" "$BACKUP_DIR/"
  fi

  ln -sfn "$src" "$dst"
  echo "Linked $dst -> $src"
}

echo "== Bootstrapping packages =="
"$DOTFILES_DIR/bin/os/$OS"
echo

# shellcheck source=zsh/.zprofile
. "$DOTFILES_DIR/zsh/.zprofile"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

echo "== Installing tools through mise =="
mise use --global node@lts npm:pnpm npm:yarn npm:tree-sitter-cli stylua shellcheck
echo

if ! command -v claude >/dev/null; then
  echo "== Installing Claude Code CLI =="
  curl -fsSL https://claude.ai/install.sh | bash
  echo
fi

echo "== Setting up oh-my-zsh =="
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
  if [ ! -d "$HOME/.oh-my-zsh/plugins/$plugin" ] && [ ! -d "$ZSH_CUSTOM/plugins/$plugin" ]; then
    git clone --depth 1 "https://github.com/zsh-users/$plugin" "$ZSH_CUSTOM/plugins/$plugin"
  fi
done
echo

echo "== Linking dotfiles =="
link "$DOTFILES_DIR/zsh/.zprofile" "$HOME/.zprofile"
link "$DOTFILES_DIR/zsh/.zshrc" "$HOME/.zshrc"
link "$DOTFILES_DIR/zsh/os" "$HOME/.config/zsh/os"
link "$DOTFILES_DIR/tmux/.tmux.conf" "$HOME/.tmux.conf"
link "$DOTFILES_DIR/git/.gitconfig" "$HOME/.gitconfig"
link "$DOTFILES_DIR/git/ignore" "$HOME/.config/git/ignore"
link "$DOTFILES_DIR/alacritty/alacritty.toml" "$HOME/.config/alacritty/alacritty.toml"
link "$DOTFILES_DIR/nvim" "$HOME/.config/nvim"
link "$DOTFILES_DIR/claude/AGENTS.md" "$HOME/.claude/CLAUDE.md"
link "$DOTFILES_DIR/claude/settings.json" "$HOME/.claude/settings.json"

for skill_dir in "$DOTFILES_DIR"/claude/skills/*/; do
  [ -d "$skill_dir" ] || continue
  name="$(basename "$skill_dir")"
  link "$DOTFILES_DIR/claude/skills/$name" "$HOME/.claude/skills/$name"
done

for family_dir in "$DOTFILES_DIR"/fonts/*/; do
  [ -d "$family_dir" ] || continue
  for font_file in "$family_dir"*; do
    link "$font_file" "$FONT_DIR/$(basename "$font_file")"
  done
done

if [ "$OS" = ubuntu ]; then
  fc-cache -f "$FONT_DIR"
fi
echo

echo "== Bootstrapping nvim =="
"$DOTFILES_DIR/nvim/bin/setup" || echo "nvim/bin/setup failed. Install the missing dependencies it listed, then rerun it directly."
echo

if ! command -v docker >/dev/null; then
  echo "Docker is not installed. Install it, then run: dbs up -d"
elif docker info >/dev/null 2>&1; then
  echo "== Starting my_db and my_redis =="
  docker compose -f "$DOTFILES_DIR/docker/compose.yml" up -d
else
  echo "Docker is installed but not reachable yet. Log out and back in, then run: dbs up -d"
fi

echo
echo "Done."
