#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if ! command -v brew >/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# shellcheck source=../../zsh/.zprofile
. "$DOTFILES_DIR/zsh/.zprofile"

brew bundle --file="$DOTFILES_DIR/Brewfile"

if [ ! -d /Applications/Alacritty.app ]; then
  echo "== Installing Alacritty =="
  ALACRITTY_TMP="$(mktemp -d)"
  ALACRITTY_DMG_URL="$(curl -fsSL https://api.github.com/repos/alacritty/alacritty/releases/latest | grep -o 'https://[^"]*\.dmg')"
  curl -fsSL "$ALACRITTY_DMG_URL" -o "$ALACRITTY_TMP/alacritty.dmg"
  ALACRITTY_MOUNT="$(hdiutil attach "$ALACRITTY_TMP/alacritty.dmg" -nobrowse -noverify | grep '/Volumes/' | sed -E 's/^.*(\/Volumes\/.*)$/\1/')"
  cp -R "$ALACRITTY_MOUNT/Alacritty.app" /Applications/
  hdiutil detach "$ALACRITTY_MOUNT" -quiet
  rm -rf "$ALACRITTY_TMP"
  xattr -dr com.apple.quarantine /Applications/Alacritty.app
fi
